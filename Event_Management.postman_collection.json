            "url": {
              "raw": "{{base_url}}/api/events/:id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "event-uuid-here",
                  "description": "The unique event UUID to update"
                }
              ]
            },
            "description": "Update an existing event. Only values provided will be updated. Requires authenticated event owner (creator) or Admin."
          },
          "response": []
