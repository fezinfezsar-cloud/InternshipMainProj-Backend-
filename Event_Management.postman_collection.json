                "{{base_url}}"
              ],
              "path": [
                "api",
                "events",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "event-uuid-here",
                  "description": "The unique event UUID"
                }
              ]
            },
            "description": "Get detailed information about a single event by its ID. Public endpoint."
          },
          "response": []
        },
