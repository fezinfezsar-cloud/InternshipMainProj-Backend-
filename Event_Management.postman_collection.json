    {
      "name": "Event Management",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/events?status=UPCOMING&search=&upcoming=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "UPCOMING",
                  "description": "Filter by status: UPCOMING, ONGOING, COMPLETED, CANCELLED"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search keyword for event title/description"
                },
                {
                  "key": "created_by",
                  "value": "",
                  "description": "Filter events created by user ID",
                  "disabled": true
                },
                {
                  "key": "upcoming",
                  "value": "true",
                  "description": "Set to true to show only upcoming events based on start_date"
                }
              ]
            },
            "description": "Get a list of events. Supports query parameters for filtering and searching. Public endpoint."
          },
          "response": []
        },
        {
          "name": "Get Event By ID",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/events/:id",
